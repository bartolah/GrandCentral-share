{
  "manifest_version": 3,
  "name": "Grand Central — Quick Todo",
  "version": "1.1",
  "description": "Add a todo to the Grand Central board from any tab, in one account, optionally filed to a project.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Add a Grand Central todo"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://gc.example.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://*.local/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open Quick Todo"
    }
  },
  "key": ""
}
