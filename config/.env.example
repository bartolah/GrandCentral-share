# Grand Central credentials — TEMPLATE (safe to commit; no real secrets here).
#
# Copy to `.env` in this same directory, fill in real values, then:
#     chmod 600 config/.env
#
# Never commit `.env`. Never log these values. (Spec §6, non-negotiable.)

# --- Gmail IMAP app passwords ---------------------------------------------
# Generate at https://myaccount.google.com/apppasswords (2-Step Verification
# must be ON for the account). Paste the 16-character password WITHOUT spaces.

# Personal Gmail
GMAIL_PERSONAL_USER=you@gmail.com
GMAIL_PERSONAL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# ConnectBlue Gmail (Google Workspace)
GMAIL_CONNECTBLUE_USER=you@yourcompany.com
GMAIL_CONNECTBLUE_APP_PASSWORD=xxxxxxxxxxxxxxxx

# --- Google Calendar (ICS secret URLs, read-only; no OAuth) ---------------
# Google Calendar → Settings → <calendar> → "Integrate calendar" →
# "Secret address in iCal format". Comma-separate multiple calendars.
# Treat these URLs as secrets: anyone holding one can read that calendar.
# Note: Google refreshes these feeds lazily (new events can lag ~hours).
GCAL_ICS_URLS=https://calendar.google.com/calendar/ical/.../basic.ics,https://calendar.google.com/calendar/ical/.../basic.ics

# --- Claude API -----------------------------------------------------------
# Used by the classifier. launchd jobs do not inherit your shell env, so the
# key must live here (not just in your shell profile).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
