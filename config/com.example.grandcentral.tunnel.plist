<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.example.grandcentral.tunnel</string>

    <!-- Cloudflare Tunnel for https://gc.example.com (config in
         ~/.cloudflared/config.yml). Gives Bart the board over plain HTTPS on
         networks that block Tailscale/VPNs. Cloudflare Access (email OTP)
         must stay enabled on the hostname — it is the only auth layer. -->
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/cloudflared</string>
        <string>tunnel</string>
        <string>run</string>
        <string>grand-central</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/you/Code/GrandCentral</string>

    <!-- Always-on like the dashboard: start at login, restart if it dies. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/Users/you/Code/GrandCentral/logs/tunnel.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/you/Code/GrandCentral/logs/tunnel.err.log</string>
</dict>
</plist>
